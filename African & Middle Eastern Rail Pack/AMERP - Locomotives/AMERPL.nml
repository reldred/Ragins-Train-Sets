// 3 Template
template template_3(x, y) {
    //left_x, upper_y, width, height, offset_x, offset_y
    //                            more negative to shift left
    //                                            more negative to shift up
    [ x,        y,        8,        29,        -3,            -25, ANIM]
    [ x+9,      y,        22,        20,        -6,        -16, ANIM]
    [ x+32,     y,        33,        16,        4,        -12, ANIM]
    [ x+66,     y,        22,        20,        -4,            -11, ANIM]

    [ x+89,     y,        8,        29,        -3,            -16, ANIM]
    [ x+98,     y,        22,        20,        -16,        -11, ANIM]
    [ x+121,    y,        33,        16,        -17,        -12, ANIM]
    [ x+155,    y,        22,        20,        -14,        -16, ANIM]
}

