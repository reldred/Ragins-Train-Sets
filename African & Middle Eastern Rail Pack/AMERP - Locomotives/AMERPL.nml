//Trains Below!

//ID
const Henschel_TT12_ID = 14000;
//introduction_date
const Henschel_TT12_IntroDate = date(1959, 1, 1);
//speed
const Henschel_TT12_Speed = 80;
//cost_factor
const Henschel_TT12_CostFactor = 39;
//running_cost_factor
const Henschel_TT12_RunningCostFactor = 105;
//power
const Henschel_TT12_Power = 1425;
//weight
const Henschel_TT12_Weight = 100;
//length
const Henschel_TT12_Length = 8;

//Henschel_TT12_Liv0
spriteset(spriteset_Henschel_TT12_Liv0_Purchase,   "gfx/Henschel_TT12_Liv0.png") {template_purchase_8(7, 21)}
spriteset(spriteset_Henschel_TT12_Liv0,   "gfx/Henschel_TT12_Liv0.png") {template_8(7, 39)}

//Purchase Sprite Stacker
switch (FEAT_TRAINS, SELF, switch_Henschel_TT12_Liv0_Purchase_Stack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Henschel_TT12_Liv0_Purchase;
    1: switch_Couplers_8F_Repeat_Purchase;
}

switch (FEAT_TRAINS, SELF, switch_Henschel_TT12_Liv0_Normal_Stack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_Henschel_TT12_Liv0;
    1: switch_Couplers_8F_Repeat;
}

const Henschel_TT12_Liv0_ID = (Henschel_TT12_ID + Liv0_ID);

item(FEAT_TRAINS, Item_Henschel_TT12_Liv0, Henschel_TT12_Liv0_ID) {
    property {
        sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     NG_RAIL;
		running_cost_base:              RUNNING_COST_DIESEL;
        engine_class:                   ENGINE_CLASS_DIESEL;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);

        name:                           string(STR_NAME_HENSCHEL_TT12);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              Henschel_TT12_IntroDate;		
		length:                         Henschel_TT12_Length;
		
		speed:							Henschel_TT12_Speed km/h;
		cost_factor:					Henschel_TT12_CostFactor;
		running_cost_factor:			Henschel_TT12_RunningCostFactor;
		cargo_capacity: 				0;
		power:							Henschel_TT12_Power;
		weight:							Henschel_TT12_Weight;
		
//        variant_group: 					Item_Henschel_TT12_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
		default: 						switch_Henschel_TT12_Liv0_Normal_Stack;
//		sound_effect: 					switch_Clyde_16_645;
        purchase: 						switch_Henschel_TT12_Liv0_Purchase_Stack;
        additional_text: 				string(STR_INFO_HENSCHEL_TT12);
		reverse_build_probability: 		return 50;
}
}

