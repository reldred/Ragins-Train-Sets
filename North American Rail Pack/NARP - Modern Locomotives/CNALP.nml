spriteset(spriteset_EMD_SDP40F_Liv10,   "gfx/EMD_SDP40F_Liv10.png") {template_8(7, 39)} // <- Define a wagon, in this case the cab
spriteset(spriteset_EMD_SDP40F_Liv10_r,   "gfx/EMD_SDP40F_Liv10.png") {template_8_r(7, 39)}

switch(FEAT_TRAINS, SELF, switch_EMD_SDP40F_Liv10_pair, position_in_vehid_chain % 2) {
 1: spriteset_EMD_SDP40F_Liv10_r;
  spriteset_EMD_SDP40F_Liv10;
}

switch(FEAT_TRAINS, SELF, switch_EMD_SDP40F_Liv10_rear, position_in_vehid_chain_from_end) {
 0: spriteset_EMD_SDP40F_Liv10_r;
  switch_EMD_SDP40F_Liv10_pair;
}

switch(FEAT_TRAINS, SELF, switch_EMD_SDP40F_Liv10_position, position_in_consist) {
 0: spriteset_EMD_SDP40F_Liv10;
  switch_EMD_SDP40F_Liv10_rear;
}

const EMD_SDP40F_Liv10_ID = (EMD_SDP40F_ID + Liv10_ID);

item(FEAT_TRAINS, Item_EMD_SDP40F_Liv10, EMD_SDP40F_Liv10_ID) {
    property {
		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     RAIL;
		running_cost_base:              RUNNING_COST_DIESEL;
        engine_class:                   ENGINE_CLASS_DIESEL;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);

        name:                           string(STR_NAME_EMD_SDP40F);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              EMD_SDP40F_IntroDate;		
		length:                         EMD_SDP40F_Length;
		
		speed:							EMD_SDP40F_Speed mph;
		cost_factor:					EMD_SDP40F_CostFactor;
		running_cost_factor:			EMD_SDP40F_RunningCostFactor;
		cargo_capacity: 				0;
		power:							EMD_SDP40F_Power;
		weight:							EMD_SDP40F_Weight;
		
        variant_group: 					Item_EMD_SDP40F_Liv6;
        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_EMD_SDP40F_Liv10_position;
//		sound_effect: 					switch_EMD_16_567;
        purchase: 						spriteset_EMD_SDP40F_Liv10_Purchase;
        additional_text: 				string(STR_INFO_EMD_SDP40F);
}
}

