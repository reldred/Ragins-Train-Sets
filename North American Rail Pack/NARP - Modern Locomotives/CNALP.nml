item(FEAT_TRAINS, Item_EMD_GF6CH_Liv46, 35896) {
    property {
        sprite_id:                        SPRITE_ID_NEW_TRAIN;
        refit_cost:                        0;
        climates_available:                (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
        bitmask_vehicle_info:            0;
        misc_flags:                        bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here

        track_type:                        OHLE_AC;
        running_cost_base:                RUNNING_COST_DIESEL;
        engine_class:                     ENGINE_CLASS_ELECTRIC;
//        ai_special_flag:                AI_FLAG_CARGO;
        dual_headed:                    0; // <- Double Headed, so cab on each end

        visual_effect_and_powered: VISUAL_EFFECT_ELECTRIC;

        name:                            string(STR_NAME_EMD_GF6CH);
        introduction_date:                date(1985,1,1);
        vehicle_life:                     50;
        model_life:                        30;
        length:                            8;

        weight:                        175 ton;
        speed:                            100 mph;
        power:                            6000 hp;
        tractive_effort_coefficient:     0.3;
        cost_factor:                     21;
        running_cost_factor:             150;
        cargo_capacity:                  0;

        variant_group: Item_EMD_GF6CH_Liv35;
        extra_flags:  bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: switch_EMD_GF6CH_Liv46_position;
		sound_effect: switch_Modern_Electric_Horn;
        purchase: spriteset_EMD_GF6CH_Liv46_Purchase;
        additional_text: string(STR_INFO_EMD_GF6CH);
}
}

spriteset(spriteset_EMD_AEM5_Pantograph_Purchase,   "gfx/EMD_AEM5_Pantographs.png") {template_purchase_8(7, 21)}

spriteset(spriteset_EMD_AEM5_PantoDown,   "gfx/EMD_AEM5_Pantographs.png") {template_8_repeat(7, 39)}
spriteset(spriteset_EMD_AEM5_PantoUp,   "gfx/EMD_AEM5_Pantographs.png") {template_8(7, 69)}
spriteset(spriteset_EMD_AEM5_PantoUp_r,   "gfx/EMD_AEM5_Pantographs.png") {template_8_r(7, 69)}

switch(FEAT_TRAINS, SELF, switch_EMD_AEM5_Fw_railtype, tile_powers_railtype("OHLE_AC")) {
 0: spriteset_EMD_AEM5_PantoDown;
 1: spriteset_EMD_AEM5_PantoUp;
}

switch(FEAT_TRAINS, SELF, switch_EMD_AEM5_r_railtype, tile_powers_railtype("OHLE_AC")) {
 0: spriteset_EMD_AEM5_PantoDown;
 1: spriteset_EMD_AEM5_PantoUp_r;
}

//EMD_AEM5_Liv0
spriteset(spriteset_EMD_AEM5_Liv0_Purchase,   "gfx/EMD_AEM5_Liv0.png") {template_purchase_8(7, 21)}
spriteset(spriteset_EMD_AEM5_Liv0,   "gfx/EMD_AEM5_Liv0.png") {template_8_repeat(7, 39)}

//Change power output based on rail type
switch (FEAT_TRAINS, SELF, switch_EMD_AEM5_Liv0_power_1, tile_powers_railtype("OHLE_AC")) {
            1: return 5000;
        }
        switch (FEAT_TRAINS, SELF, switch_EMD_AEM5_Liv0_power_0, tile_powers_railtype("SAA3")) {
            1: return 4200;
                return switch_EMD_AEM5_Liv0_power_1;
        }

//Change effects based on railtype
switch (FEAT_TRAINS, SELF, switch_EMD_AEM5_Liv0_effect_spawn_model_and_powered, [tile_powers_railtype("SAA3")]) {
            1: return VISUAL_EFFECT_DISABLE;
            return visual_effect_and_powered(VISUAL_EFFECT_ELECTRIC, 3, ENABLE_WAGON_POWER);
        }

//Power Language File Switch
switch (FEAT_TRAINS, SELF, switch_EMD_AEM5_Liv0_buy_menu_additional_text, [
                STORE_TEMP(
                    string(STR_POWER_SOURCE_OHLE_AC)
                    | (5000 << 16),
                    0x100
                ),
                STORE_TEMP(
                    string(STR_POWER_SOURCE_3RAIL)
                    | (4200 << 16),
                    0x101
                ),
        ]) {
            return string(STR_BUY_MENU_ADDITIONAL_TEXT_WRAPPER_TWO_SUBSTR, string(STR_POWER_BY_POWER_SOURCE_TWO_SOURCES), string(STR_INFO_EMD_AEM5));
        }

//Purchase Sprite Stacker
switch (FEAT_TRAINS, SELF, switch_EMD_AEM5_Liv0_Purchase_Stack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_EMD_AEM5_Liv0_Purchase;
	1: spriteset_EMD_AEM5_Pantograph_Purchase;
}

switch (FEAT_TRAINS, SELF, switch_EMD_AEM5_Liv0_Fw, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_EMD_AEM5_Liv0;
    1: switch_EMD_AEM5_Fw_railtype;
}

switch (FEAT_TRAINS, SELF, switch_EMD_AEM5_Liv0_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 2 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_EMD_AEM5_Liv0;
    1: switch_EMD_AEM5_r_railtype;
}

