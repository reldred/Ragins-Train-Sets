//EMC_E1_Liv0
spriteset(spriteset_EMC_E1_Liv0_Purchase,   "gfx/EMC_E1_Liv0.png") {template_purchase_88(7, 21)}

spriteset(spriteset_EMC_E1_Liv0_A,   "gfx/EMC_E1_Liv0.png") {template_8(7, 39)}
spriteset(spriteset_EMC_E1_Liv0_B,   "gfx/EMC_E1_Liv0.png") {template_8(7, 69)}

switch(FEAT_TRAINS, SELF, switch_EMC_E1_Liv0_lead_Altcheck, position_in_consist_from_end) {
 0: spriteset_EMC_E1_Liv0_A; // <- not flipped
  spriteset_EMC_E1_Liv0_B; // <- flipped
}
 
switch(FEAT_TRAINS, SELF, switch_EMC_E1_Liv0_lead_flipcheck, vehicle_is_flipped) {
 0: spriteset_EMC_E1_Liv0_A; // <- not flipped
 1: switch_EMC_E1_Liv0_lead_Altcheck; // <- flipped
}

switch(FEAT_TRAINS, SELF, switch_EMC_E1_Liv0_rear_flipcheck, vehicle_is_flipped) {
 0: spriteset_EMC_E1_Liv0_B; // <- not flipped
 1: spriteset_EMC_E1_Liv0_A; // <- flipped
}

switch(FEAT_TRAINS, SELF, switch_EMC_E1_Liv0_rear_position, position_in_vehid_chain_from_end) {
 0: switch_EMC_E1_Liv0_rear_flipcheck;
  spriteset_EMC_E1_Liv0_B;
}

switch(FEAT_TRAINS, SELF, switch_EMC_E1_Liv0_graphics, position_in_vehid_chain) {
 0: switch_EMC_E1_Liv0_lead_flipcheck;
  switch_EMC_E1_Liv0_rear_position;
}

const EMC_E1_Liv0_ID = (EMC_E1_ID + Liv0_ID);

item(FEAT_TRAINS, Item_EMC_E1_Liv0, EMC_E1_Liv0_ID) {
    property {
		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     RAIL;
		running_cost_base:              RUNNING_COST_DIESEL;
        engine_class:                   ENGINE_CLASS_DIESEL;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);

        name:                           string(STR_NAME_EMC_E1);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              EMC_E1_IntroDate;		
		length:                         EMC_E1_Length;
		
		speed:							EMC_E1_Speed mph;
		cost_factor:					EMC_E1_CostFactor;
		running_cost_factor:			EMC_E1_RunningCostFactor;
		cargo_capacity: 				0;
		power:							EMC_E1_Power;
		weight:							EMC_E1_Weight;
		
//        variant_group: 					Item_EMC_E1_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_EMC_E1_Liv0_graphics;
//		sound_effect: 					switch_EMD_16_567;
        purchase: 						spriteset_EMC_E1_Liv0_Purchase;
        additional_text: 				string(STR_INFO_EMC_E1);
}
}

