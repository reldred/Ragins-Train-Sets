//EMD_DM30AC_Liv0
spriteset(spriteset_EMD_DM30AC_Liv0_Purchase,   "gfx/EMD_DM30AC_Liv0.png") {template_purchase_8(7, 21)}

spriteset(spriteset_EMD_DM30AC_Liv0,   "gfx/EMD_DM30AC_Liv0.png") {template_8(7, 39)} // <- Define a wagon, in this case the cab
spriteset(spriteset_EMD_DM30AC_Liv0_r,   "gfx/EMD_DM30AC_Liv0.png") {template_8_r(7, 39)}

//Change power output based on rail type
switch (FEAT_TRAINS, SELF, switch_EMD_DM30AC_Liv0_power_1, tile_powers_railtype("RAIL")) {
            1: return 3000;
        }
        switch (FEAT_TRAINS, SELF, switch_EMD_DM30AC_Liv0_power_0, tile_powers_railtype("SAA3")) {
            1: return 3100;
                return switch_EMD_DM30AC_Liv0_power_1;
        }

//Change effects based on railtype
switch (FEAT_TRAINS, SELF, switch_EMD_DM30AC_Liv0_effect_spawn_model_and_powered, [tile_powers_railtype("SAA3")]) {
            1: return VISUAL_EFFECT_DISABLE;
            return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);
        }

//Power Language File Switch
switch (FEAT_TRAINS, SELF, switch_EMD_DM30AC_Liv0_buy_menu_additional_text, [
                STORE_TEMP(
                    string(STR_POWER_SOURCE_DIESEL)
                    | (3000 << 16),
                    0x100
                ),
                STORE_TEMP(
                    string(STR_POWER_SOURCE_3RAIL)
                    | (3100 << 16),
                    0x101
                ),
        ]) {
            return string(STR_BUY_MENU_ADDITIONAL_TEXT_WRAPPER_TWO_SUBSTR, string(STR_POWER_BY_POWER_SOURCE_TWO_SOURCES), string(STR_INFO_EMD_DM30AC));
        }

switch(FEAT_TRAINS, SELF, switch_EMD_DM30AC_Liv0_pair, position_in_vehid_chain % 2) {
 1: spriteset_EMD_DM30AC_Liv0_r;
  spriteset_EMD_DM30AC_Liv0;
}

switch(FEAT_TRAINS, SELF, switch_EMD_DM30AC_Liv0_rear, position_in_vehid_chain_from_end) {
 0: spriteset_EMD_DM30AC_Liv0_r;
  switch_EMD_DM30AC_Liv0_pair;
}

switch(FEAT_TRAINS, SELF, switch_EMD_DM30AC_Liv0_position, position_in_consist) {
 0: spriteset_EMD_DM30AC_Liv0;
  switch_EMD_DM30AC_Liv0_rear;
}

