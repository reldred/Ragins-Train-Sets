spriteset(spriteset_GE_Genesis_P40Greebles,   "gfx/GE_Genesis_P40Greebles.png") {template_8(7, 39)}
spriteset(spriteset_GE_Genesis_P40Greebles_r,   "gfx/GE_Genesis_P40Greebles.png") {template_8_r(7, 39)}

//GE_P40DC_Liv0
spriteset(spriteset_GE_Genesis_Liv0A_Purchase,   "gfx/GE_Genesis_Liv0A.png") {template_purchase_8(7, 21)}
spriteset(spriteset_GE_Genesis_Liv0A,   "gfx/GE_Genesis_Liv0A.png") {template_8(7, 39)}
spriteset(spriteset_GE_Genesis_Liv0A_r,   "gfx/GE_Genesis_Liv0A.png") {template_8_r(7, 39)}

spriteset(spriteset_GE_Genesis_Liv0B_Purchase,   "gfx/GE_Genesis_Liv0B.png") {template_purchase_8(7, 21)}
spriteset(spriteset_GE_Genesis_Liv0B,   "gfx/GE_Genesis_Liv0B.png") {template_8(7, 39)}
spriteset(spriteset_GE_Genesis_Liv0B_r,   "gfx/GE_Genesis_Liv0B.png") {template_8_r(7, 39)}

spriteset(spriteset_GE_Genesis_Liv0C_Purchase,   "gfx/GE_Genesis_Liv0C.png") {template_purchase_8(7, 21)}
spriteset(spriteset_GE_Genesis_Liv0C,   "gfx/GE_Genesis_Liv0C.png") {template_8(7, 39)}
spriteset(spriteset_GE_Genesis_Liv0C_r,   "gfx/GE_Genesis_Liv0C.png") {template_8_r(7, 39)}

switch (FEAT_TRAINS, SELF, switch_GE_40DC_Liv0_Forward_Stack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_GE_Genesis_Liv0A;
    1: spriteset_GE_Genesis_P40Greebles;
}

switch (FEAT_TRAINS, SELF, switch_GE_40DC_Liv0_Backward_Stack, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_GE_Genesis_Liv0A_r;
    1: spriteset_GE_Genesis_P40Greebles_r;
}

switch(FEAT_TRAINS, SELF, switch_GE_P40DC_Liv0_pair, position_in_vehid_chain % 2) {
 1: switch_GE_40DC_Liv0_Backward_Stack;
  switch_GE_40DC_Liv0_Forward_Stack;
}

switch(FEAT_TRAINS, SELF, switch_GE_P40DC_Liv0_rear, position_in_vehid_chain_from_end) {
 0: switch_GE_40DC_Liv0_Backward_Stack;
  switch_GE_P40DC_Liv0_pair;
}

switch(FEAT_TRAINS, SELF, switch_GE_P40DC_Liv0_position, position_in_consist) {
 0: switch_GE_40DC_Liv0_Forward_Stack;
  switch_GE_P40DC_Liv0_rear;
}

const GE_P40DC_Liv0_ID = (GE_P40DC_ID + Liv0_ID);

item(FEAT_TRAINS, Item_GE_P40DC_Liv0, GE_P40DC_Liv0_ID) {
    property {
		sprite_id:                      SPRITE_ID_NEW_TRAIN;
		misc_flags:                     bitmask(TRAIN_FLAG_2CC, TRAIN_FLAG_SPRITE_STACK); // <- Train Flag MU needed here
		track_type:                     RAIL;
		running_cost_base:              RUNNING_COST_DIESEL;
        engine_class:                   ENGINE_CLASS_DIESEL;
//        ai_special_flag:                AI_FLAG_PASSENGER;
		bitmask_vehicle_info:           0;
	
		climates_available:             (param_RealDisable == 0) ? ALL_CLIMATES : NO_CLIMATE;
		visual_effect_and_powered: 		visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);

        name:                           string(STR_NAME_GE_P40DC);
		
		refit_cost:                     0;
        dual_headed:                    0;
        air_drag_coefficient:           0.08;
        model_life:                     30;
		vehicle_life:                   50;
		tractive_effort_coefficient:	0.3;
		
        introduction_date:              GE_P40DC_IntroDate;		
		length:                         GE_P40DC_Length;
		
		speed:							GE_P40DC_Speed mph;
		cost_factor:					GE_P40DC_CostFactor;
		running_cost_factor:			GE_P40DC_RunningCostFactor;
		cargo_capacity: 				0;
		power:							GE_P40DC_Power;
		weight:							GE_P40DC_Weight;
		
//        variant_group: 					Item_GE_P40DC_Liv0;
//        extra_flags:  					bitmask (VEHICLE_FLAG_DISABLE_NEW_VEHICLE_MESSAGE, VEHICLE_FLAG_DISABLE_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_EXCLUSIVE_PREVIEW, VEHICLE_FLAG_SYNC_VARIANT_RELIABILITY);
    }
    graphics {
        default: 						switch_GE_P40DC_Liv0_position;
//		sound_effect: 					switch_EMD_16_567;
        purchase: 						spriteset_GE_Genesis_Liv0A_Purchase;
        additional_text: 				string(STR_INFO_GE_P40DC);
}
}

