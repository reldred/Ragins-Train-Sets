//EMD_FL9_Liv12
spriteset(spriteset_EMD_FL9_Liv12_Purchase,   "gfx/EMD_FL9_Liv12.png") {template_purchase_8(7, 21)}

spriteset(spriteset_EMD_FL9_Liv12,   "gfx/EMD_FL9_Liv12.png") {template_8(7, 39)} // <- Define a wagon, in this case the cab
spriteset(spriteset_EMD_FL9_Liv12_r,   "gfx/EMD_FL9_Liv12.png") {template_8_r(7, 39)}

//Change power output based on rail type
switch (FEAT_TRAINS, SELF, switch_EMD_FL9_Liv12_power_1, tile_powers_railtype("RAIL")) {
            1: return 1750;
        }
        switch (FEAT_TRAINS, SELF, switch_EMD_FL9_Liv12_power_0, tile_powers_railtype("SAA3")) {
            1: return 1800;
                return switch_EMD_FL9_Liv12_power_1;
        }

//Change effects based on railtype
switch (FEAT_TRAINS, SELF, switch_EMD_FL9_Liv12_effect_spawn_model_and_powered, [tile_powers_railtype("SAA3")]) {
            1: return VISUAL_EFFECT_DISABLE;
            return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);
        }

//Power Language File Switch
switch (FEAT_TRAINS, SELF, switch_EMD_FL9_Liv12_buy_menu_additional_text, [
                STORE_TEMP(
                    string(STR_POWER_SOURCE_DIESEL)
                    | (1750 << 16),
                    0x100
                ),
                STORE_TEMP(
                    string(STR_POWER_SOURCE_3RAIL)
                    | (1800 << 16),
                    0x101
                ),
        ]) {
            return string(STR_BUY_MENU_ADDITIONAL_TEXT_WRAPPER_TWO_SUBSTR, string(STR_POWER_BY_POWER_SOURCE_TWO_SOURCES), string(STR_INFO_EMD_FL9));
        }

switch(FEAT_TRAINS, SELF, switch_EMD_FL9_Liv12_pair, position_in_vehid_chain % 2) {
 1: spriteset_EMD_FL9_Liv12_r;
  spriteset_EMD_FL9_Liv12;
}

