//Change power output based on rail type
switch (FEAT_TRAINS, SELF, switch_EMD_F70PHDM_Liv0_power_1, tile_powers_railtype("RAIL")) {
            1: return EMD_F70PHDM_Diesel_Power;
        }
        switch (FEAT_TRAINS, SELF, switch_EMD_F70PHDM_Liv0_power_0, tile_powers_railtype("SAA3")) {
            1: return EMD_F70PHDM_3Rail_Power;
                return switch_EMD_F70PHDM_Liv0_power_1;
