switch(FEAT_TRAINS, PARENT, switch_sfx_gec_run, current_speed){
	0..16 : sound("sfx/GEC_slow.wav", 70) ;
	17..26 : sound("sfx/GEC_med.wav", 70) ;
	sound("sfx/GEC_fast.wav", 70) ;
}


//Electric Locomotives
switch(FEAT_TRAINS, SELF, switch_Early_Electric_Whistle, getbits(extra_callback_info1, 0, 8)){
