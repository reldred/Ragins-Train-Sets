        visual_effect_and_powered: visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);

        name:                            string(STR_NAME_EMD_SD70);
        introduction_date:                date(1992,1,1);
        vehicle_life:                     50;
        model_life:                        30;
        length:                            8;

        weight:                        178 ton;
        speed:                            70 mph;
        power:                            4000 hp;
        tractive_effort_coefficient:     0.5;
        cost_factor:                     19;
        running_cost_factor:             178;
		cargo_capacity:                  0;

