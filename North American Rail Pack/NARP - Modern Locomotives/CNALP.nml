//EMD_FT_Liv0
spriteset(spriteset_EMD_FT_Liv0_Purchase,   "gfx/EMD_FT_Liv0.png") {template_purchase_66(7, 21)}

spriteset(spriteset_EMD_FT_Liv0_A,   "gfx/EMD_FT_Liv0.png") {template_6(7, 39)}
spriteset(spriteset_EMD_FT_Liv0_B,   "gfx/EMD_FT_Liv0.png") {template_6(7, 69)}

switch(FEAT_TRAINS, SELF, switch_EMD_FT_Liv0_lead_Altcheck, position_in_consist_from_end) {
 0: spriteset_EMD_FT_Liv0_A; // <- not flipped
  spriteset_EMD_FT_Liv0_B; // <- flipped
}
 
switch(FEAT_TRAINS, SELF, switch_EMD_FT_Liv0_lead_flipcheck, vehicle_is_flipped) {
 0: spriteset_EMD_FT_Liv0_A; // <- not flipped
