spriteset(spriteset_GE_ES44ACE_Liv0_r,   "gfx/GE_ES44ACE_Liv0.png") {template_8_r(7, 39)}

//Change power output based on rail type
switch (FEAT_TRAINS, SELF, switch_GE_ES44ACE_Liv0_power_1, tile_powers_railtype("RAIL")) {
            1: return 4400;
        }
        switch (FEAT_TRAINS, SELF, switch_GE_ES44ACE_Liv0_power_0, tile_powers_railtype("OHLE_AC")) {
            1: return 5400;
                return switch_GE_ES44ACE_Liv0_power_1;
        }

//Change effects based on railtype
switch (FEAT_TRAINS, SELF, switch_GE_ES44ACE_Liv0_effect_spawn_model_and_powered, [tile_powers_railtype("OHLE_AC")]) {
            1: return VISUAL_EFFECT_ELECTRIC;
            return visual_effect_and_powered(VISUAL_EFFECT_DIESEL, 3, DISABLE_WAGON_POWER);
        }

//Power Language File Switch
switch (FEAT_TRAINS, SELF, switch_GE_ES44ACE_Liv0_buy_menu_additional_text, [
                STORE_TEMP(
                    string(STR_POWER_SOURCE_DIESEL)
                    | (4400 << 16),
                    0x100
                ),
                STORE_TEMP(
                    string(STR_POWER_SOURCE_OHLE_AC)
                    | (5400 << 16),
                    0x101
                ),
        ]) {
            return string(STR_BUY_MENU_ADDITIONAL_TEXT_WRAPPER_TWO_SUBSTR, string(STR_POWER_BY_POWER_SOURCE_TWO_SOURCES), string(STR_INFO_GE_ES44ACE));
        }


