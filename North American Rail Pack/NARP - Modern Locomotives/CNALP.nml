    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_GE_E50C_Liv0;
    1: spriteset_GE_E50C_PantoDown;
}

//Reversed Pantograph Lowered
switch (FEAT_TRAINS, SELF, switch_GE_E50C_Liv0_PantoLowered_r, [
    STORE_TEMP((getbits(extra_callback_info1, 8, 8) < 1 ? CB_FLAG_MORE_SPRITES : 0) | PALETTE_USE_DEFAULT, 0x100),
    getbits(extra_callback_info1, 8, 8)
    ]) {
    0: spriteset_GE_E50C_Liv0_r;
    1: spriteset_GE_E50C_PantoDown_r;    // Return the overlay
}


//Panto Up Grouping
switch(FEAT_TRAINS, SELF, switch_GE_E50C_Liv0_pair, position_in_vehid_chain % 2) {
 1: switch_GE_E50C_Liv0_Panto_r;
  switch_GE_E50C_Liv0_Panto;
}

